<% if (typeof successMessages !== 'undefined' && successMessages && successMessages.length) { %>
    <% successMessages.forEach(message => { %>
        <div class="alert alert-success"><%= message %></div>
    <% }) %>
<% } %>

<% if (typeof messages !== 'undefined' && messages && messages.length) { %>
    <% messages.forEach(message => { %>
        <div class="alert alert-danger"><%= message %></div>
    <% }) %>
<% } %>

<div class="card h-100">

    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Category Management</h5>
        <button
            type="button"
            class="btn btn-success btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#newCategoryModal"
        >
            + Add Category
        </button>
    </div>

    <div class="card-body p-0">
        <% if (categoryList.length === 0) { %>
            <p class="text-muted p-3 mb-0">No categories yet. Add one to get started.</p>
        <% } else { %>
            <ul class="list-group list-group-flush">
                <% categoryList.forEach(function(cat) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span><%= cat.categoryName %></span>
                        <div class="d-flex gap-1">
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#editCategoryModal<%= cat.categoryId %>"
                            >
                                Edit
                            </button>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteCategoryModal<%= cat.categoryId %>"
                            >
                                Delete
                            </button>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </div>

</div>

<%- include('newCategory') %>

<% categoryList.forEach(function(cat) { %>
    <%- include('updateCategory', { category: cat }) %>
    <%- include('deleteCategory', { category: cat }) %>
<% }); %>
