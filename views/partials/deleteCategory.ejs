<%# Tara %>

<div
    class="modal fade"
    id="deleteCategoryModal<%= category.categoryId %>"
    tabindex="-1"
    aria-labelledby="deleteCategoryModalLabel<%= category.categoryId %>"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">

            <form method="POST" action="/categories/<%= category.categoryId %>/delete">

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteCategoryModalLabel<%= category.categoryId %>">
                        Delete Category
                    </h5>
                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>
                </div>

                <div class="modal-body">
                    <p>Are you sure you want to delete the category:</p>
                    <h5 class="mb-3"><%= category.categoryName %></h5>
                    <p class="text-muted small mb-0">
                        This only removes the category from the list used by the
                        filter dropdown. Existing ingredients keep their current
                        category text and are not affected.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Category</button>
                </div>

            </form>

        </div>
    </div>
</div>
