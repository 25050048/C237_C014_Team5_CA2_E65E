<nav class="site-navbar">

    <a class="navbar-brand-plain" href="/">
        Pantry
    </a>

    <div class="navbar-links">

        <a class="nav-tab" data-path="/" href="/">
            Home
        </a>

        <% if (typeof user !== 'undefined' && user) { %>

            <!-- ========================= -->
            <!-- CHEF -->
            <!-- ========================= -->
            <% if (user.role === 'Chef') { %>

                <a class="nav-tab" data-path="/expirymonitoring" href="/expirymonitoring">
                    Expiry Monitoring
                </a>

                <!-- Record Usage intentionally omitted for SuperAdmin -->

                <a class="nav-tab" data-path="/expiryrequests" href="/expiryrequests">
                    Stock Requests
                </a>

            <!-- ========================= -->
            <!-- MANAGER -->
            <!-- ========================= -->
            <% } else if (user.role === 'Manager') { %>

                <a class="nav-tab" data-path="/manage-inventory" href="/manage-inventory">
                    Manage Inventory
                </a>

                <a class="nav-tab" data-path="/expirymonitoring" href="/expirymonitoring">
                    Expiry Monitoring
                </a>

                <a class="nav-tab" data-path="/ingredient-usage" href="/ingredient-usage">
                    Record Usage
                </a>

                <a class="nav-tab" data-path="/expiryrequests" href="/expiryrequests">
                    Stock Requests
                </a>

            <!-- ========================= -->
            <!-- SUPERADMIN -->
            <!-- ========================= -->
            <% } else if (user.role === 'SuperAdmin') { %>

                <a class="nav-tab" data-path="/manage-inventory" href="/manage-inventory">
                    Manage Inventory
                </a>

                <a class="nav-tab" data-path="/user-management" href="/user-management">
                    User Management
                </a>

                <a class="nav-tab" data-path="/expirymonitoring" href="/expirymonitoring">
                    Expiry Monitoring
                </a>

                <a class="nav-tab" data-path="/ingredient-usage" href="/ingredient-usage">
                    Record Usage
                </a>

                <a class="nav-tab" data-path="/expiryrequests" href="/expiryrequests">
                    Stock Requests
                </a>

            <% } %>

            <!-- ========================= -->
            <!-- PROFILE -->
            <!-- ========================= -->

            <a class="nav-avatar" href="/profile" title="Profile">

                <% if (user.profilePicture) { %>

                    <img
                        src="/images/<%= user.profilePicture %>"
                        alt="Profile"
                        class="nav-avatar-img"
                    >

                <% } else { %>

                    <span class="nav-avatar-fallback">
                        <%= user.fullName
                            ? user.fullName.charAt(0).toUpperCase()
                            : 'U' %>
                    </span>

                <% } %>

            </a>

        <% } else { %>

            <a class="nav-tab" data-path="/register" href="/register">
                Register
            </a>

            <a class="nav-tab" data-path="/login" href="/login">
                Login
            </a>

        <% } %>

    </div>

</nav>

<script>
(function () {
    const currentPath = window.location.pathname;

    document.querySelectorAll(".nav-tab").forEach(link => {
        const linkPath = link.dataset.path;

        if (
            currentPath === linkPath ||
            (linkPath !== "/" && currentPath.startsWith(linkPath))
        ) {
            link.classList.add("active");
        }
    });
})();
</script>