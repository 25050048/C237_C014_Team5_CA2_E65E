<div
    class="modal fade"
    id="newCategoryModal"
    tabindex="-1"
    aria-labelledby="newCategoryModalLabel"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="POST" action="/categories/new">

                <div class="modal-header">
                    <h5 class="modal-title" id="newCategoryModalLabel">Add Category</h5>
                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">Category Name</label>
                        <input
                            type="text"
                            id="categoryName"
                            name="categoryName"
                            class="form-control"
                            placeholder="Example: Seafood"
                            value="<%= (typeof formData !== 'undefined' && formData.categoryName) ? formData.categoryName : '' %>"
                            maxlength="50"
                            required
                        >
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Category</button>
                </div>

            </form>

        </div>
    </div>
</div>
